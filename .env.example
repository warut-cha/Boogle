# IBM Jeff Security Analyst - Environment Configuration Template
# ===============================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# IBM watsonx.ai Configuration (Bob AI Engine)
# ---------------------------------------------
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# Bob AI Configuration
BOB_ENABLED=true
BOB_MOCK_MODE=false
BOB_MAX_TOKENS=2000
BOB_TEMPERATURE=0.7
BOB_TOP_P=0.9
BOB_TOP_K=50

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Database Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=security_analyst
MONGODB_USERNAME=
MONGODB_PASSWORD=
SQLITE_PATH=./data/security_analyst.db

# Security Configuration
SECRET_KEY=your_secret_key_here_change_in_production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Analysis Configuration
STATIC_ANALYSIS_ENABLED=true
RUNTIME_ANALYSIS_ENABLED=true
DEPRECATED_API_DETECTION_ENABLED=true
CORRELATION_ENABLED=true
MIN_CONFIDENCE_SCORE=0.7
ANOMALY_THRESHOLD=0.85

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/security_analyst.log

# Performance Configuration
MAX_WORKERS=4
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Notification Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=security@example.com
SLACK_WEBHOOK_URL=
WEBHOOK_URL=

# Rust Scanner Configuration
RUST_SCANNER_PATH=./rust-scanner/target/release/rust-scanner

# Mock Data Configuration
MOCK_DATA_ENABLED=true
MOCK_REPOS_PATH=./mock_data/repos
MOCK_LOGS_PATH=./mock_data/logs