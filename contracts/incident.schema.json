{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Incident",
  "description": "Correlated security incident",
  "type": "object",
  "required": [
    "incident_id",
    "title",
    "severity",
    "severity_level",
    "confidence_score",
    "confidence_reasons",
    "confidence_limitations",
    "affected_repos",
    "affected_files",
    "affected_endpoints",
    "affected_database_tables",
    "findings",
    "attack_path",
    "related_memory"
  ],
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "severity_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence_limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "affected_repos": {
      "type": "array",
      "items": { "type": "string" }
    },
    "affected_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "affected_endpoints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "affected_database_tables": {
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "finding.schema.json" }
    },
    "attack_path": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "type"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["secret", "api", "runtime", "database", "infrastructure", "impact"]
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "label"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        }
      }
    },
    "related_memory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "memory_type",
          "incident_pattern",
          "root_cause",
          "signals_to_watch",
          "prevention_rule",
          "recommended_tests"
        ],
        "properties": {
          "memory_type": {
            "type": "string",
            "enum": ["security_prevention_rule", "incident_pattern", "false_positive_rule"]
          },
          "incident_pattern": { "type": "string" },
          "root_cause": { "type": "string" },
          "signals_to_watch": {
            "type": "array",
            "items": { "type": "string" }
          },
          "prevention_rule": { "type": "string" },
          "recommended_tests": {
            "type": "array",
            "items": { "type": "string" }
          },
          "severity_escalation_conditions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}